# Copie para ".env" (na raiz) e descomente só o que quiser mudar. Nada é
# obrigatório: senha do admin, segredos e chaves de Web Push são gerados na
# primeira subida e ficam guardados no volume "data".

# Domínio apontado para este servidor (portas 80 e 443 abertas): HTTPS automático.
# Sem isso, o sistema responde em http://localhost.
# SITE_ADDRESS=geo.exemplo.edu.br

# Portas no computador/servidor. HTTPS automático precisa de 80 e 443.
# HTTP_PORT=80
# HTTPS_PORT=443

# ADMIN_EMAIL=admin@gmail.com
# ADMIN_PASSWORD=escolha-uma-senha-forte
# ADMIN_SESSION_HOURS=12

# Endereço usado pelo aplicativo Android (docker compose run --rm --build apk).
# API_BASE_URL=https://geo.exemplo.edu.br

# Só se precisar manter o token de APKs já instalados.
# APP_AUTH_TOKEN=

# Contato informado aos serviços de push (padrão: mailto:ADMIN_EMAIL).
# VAPID_SUBJECT=mailto:professor@exemplo.edu.br

# true cria locais e respostas de exemplo.
# SEED_SAMPLE_DATA=false
