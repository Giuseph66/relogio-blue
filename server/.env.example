PORT=3001
HOST=127.0.0.1
DB_PATH=./data/app.db
APP_AUTH_TOKEN=dev-mobile-token
INTERNAL_AUTH_TOKEN=dev-internal-token
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE
ADMIN_COOKIE_SECRET=relogio-blutu-admin-secret
ADMIN_SESSION_HOURS=12
ENABLE_APP_AUTH=true
ALLOW_LEGACY_MESSAGE_POST_WITHOUT_AUTH=true
MESSAGE_RETENTION_LIMIT=500
JOB_BATCH_SIZE=100
STALE_JOB_MINUTES=15
JOB_HISTORY_RETENTION_DAYS=30
SEED_SAMPLE_DATA=false
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
# Diretório do build PWA (opcional; padrão: server/public/app).
# PWA_DIR=/caminho/absoluto/relogio-blutu/build/web

# Web Push opcional. Gere uma vez: npm run push:keys
# Configure as três variáveis para habilitar; não publique a chave privada.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
